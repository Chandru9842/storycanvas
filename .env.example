# Server Configuration
PORT=3001

# Gemini API Key (Required for Story Generation & Gemini TTS)
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Scene Illustration Provider: 'pollinations' | 'huggingface' | 'openai'
IMAGE_PROVIDER=pollinations
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_api_key_here

# Narration Voice Provider: 'gemini_tts' | 'browser_speech'
TTS_PROVIDER=gemini_tts
